NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only values below. Never prefix these with NEXT_PUBLIC_.
# Required company discovery provider; stored privately in Supabase Vault.
EXA_API_KEY=
OPENAI_API_KEY=
OPENAI_EMAIL_MODEL=gpt-4.1-mini
OUTREACH_ADMIN_EMAILS=oritsoftware@gmail.com
# Random secret of at least 32 characters; also configure it in the scheduler.
CRON_SECRET=
# Google App Password for oritsoftware@gmail.com, not your usual Google password.
# Requires 2-Step Verification. https://myaccount.google.com/apppasswords
GMAIL_USER=oritsoftware@gmail.com
GMAIL_APP_PASSWORD=
# Only scan Inbox messages received on/after this date. Change to backfill older mail.
EMAIL_START_DATE=2026-10-17

# Valid business postal address for commercial email footer (not an email address).
OUTREACH_POSTAL_ADDRESS=
OUTREACH_DAILY_LIMIT=5
OUTREACH_FOCUS=independent US ecommerce brands selling physical consumer products, especially home goods and reusable products
OUTREACH_FUNCTION_URL=https://whruftwhzlazcahmviuy.supabase.co/functions/v1/orit-outreach
# Only needed by the optional web dashboard server; Edge Functions receive this automatically.
SUPABASE_SERVICE_ROLE_KEY=
