NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Generate once with `openssl rand -base64 32`; keep it stable to preserve the
# local workspace across server restarts and browser tabs.
ORIT_WORKSPACE_SECRET=
# Optional when upgrading an existing browser-cookie workspace: set its owner
# UUID so existing projects and runs appear in the shared local workspace.
ORIT_LOCAL_OWNER_ID=

# Server-only provider credentials. Do not prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
EXA_API_KEY=
SOLARI_API_KEY=
# A deep run creates its respondent survey through https://api.tally.so/mcp.
# The local Node worker needs its own Tally API key; the Codex plugin's OAuth
# connection is separate and is not available to the worker.
TALLY_API_KEY=
# Optional when the Tally account has more than one workspace.
TALLY_WORKSPACE_ID=
# Terac feasibility, participant recruitment, and submission confirmation use
# its MCP connection. Paid study launch still requires owner quote approval.
TERAC_API_KEY=

# Zero disables the optional per-run USD caps and daily run count. Actual
# provider usage and estimated costs are still recorded for every run.
RESEARCH_BUDGET_LIGHT_RESEARCH_USD=0
RESEARCH_BUDGET_LIGHT_SIMULATION_USD=0
RESEARCH_BUDGET_DEEP_SIMULATION_USD=0
RESEARCH_DAILY_RUN_LIMIT=0

# Incoming mail and optional outbound outreach. Use a Google App Password for
# the dedicated inbox; do not use your normal Google account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Inbox scan lower bound, YYYY-MM-DD. Older mail is ignored.
EMAIL_START_DATE=2026-10-17
# Optional outbound prospecting and email delivery settings.
OPENAI_EMAIL_MODEL=gpt-4.1-mini
CRON_SECRET=
OUTREACH_POSTAL_ADDRESS=
OUTREACH_DAILY_LIMIT=5
OUTREACH_FOCUS=independent US ecommerce brands selling physical consumer products, especially home goods and reusable products
# Set only when using the hosted Supabase Edge Function. Use your OritApp URL.
OUTREACH_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/orit-outreach

# Start light simulations from authenticated, complete product emails.
EMAIL_RESEARCH_INTAKE_ENABLED=true
# Optional future paid flow; when enabled, it replaces the direct email handoff.
PAID_EMAIL_INTAKE_ENABLED=false
# Production account read credential: payment:basic:read, member:email:read,
# payment:dispute:read and refund visibility. Never expose it in browser code.
WHOP_API_KEY=
# Local-only alternative: use the logged-in official Whop CLI/keychain.
WHOP_USE_CLI=false
# Optional separate >=32-character secret. Defaults to ORIT_WORKSPACE_SECRET.
WHOP_INTAKE_SIGNING_SECRET=
